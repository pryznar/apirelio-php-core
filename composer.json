{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tracium/php-core",
    "description": "Framework-independent event and transport core for Tracium PHP SDKs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/uid": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Tracium\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tracium\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
